# Copy this file to .env for local development.
# Live site: https://morrowbean.netlify.app — a static site with no backend.
# The browser talks to n8n directly; n8n is the only thing that runs behind the site.
#
# These VITE_ values are baked into the site at build time. On Netlify, set them under
# Site configuration → Environment variables, then trigger a new deploy.
# Both URLs are public by design — never put API keys or secrets in a VITE_ variable.

# n8n "Website Chat" node → Chat URL. Powers the chat widget on every page.
# e.g. https://<your-workspace>.app.n8n.cloud/webhook/00000000-0000-4000-8000-000000000901/chat
VITE_N8N_CHAT_URL=

# n8n "Order Events Webhook" node → Production URL. Receives orders (order.created)
# and contact-form messages (inquiry.created); n8n re-prices every order from the menu.
# e.g. https://<your-workspace>.app.n8n.cloud/webhook/morrow-events
VITE_N8N_EVENTS_URL=
